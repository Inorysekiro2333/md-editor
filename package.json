{
  "name": "md-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source cross-platform WYSIWYG Markdown editor",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "measure": "node scripts/measure-startup.mjs",
    "build": "pnpm build:app && electron-builder",
    "dist": "pnpm build:app && electron-builder",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:watch": "vitest --exclude \"e2e/**\"",
    "test:coverage": "vitest run --exclude \"e2e/**\" --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p packages/editor/tsconfig.json && tsc --noEmit -p packages/app/tsconfig.json && tsc --noEmit -p packages/theming/tsconfig.json && tsc --noEmit -p packages/export/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "pnpm build:app && playwright test",
    "e2e:install": "playwright install chromium",
    "theme:check": "node scripts/theme-check.mjs",
    "perf:check": "node scripts/perf-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9"
  }
}
